{
  "name": "session-tool-cli",
  "version": "0.1.0",
  "private": true,
  "description": "The dsh-session CLI: an auxiliary operator for the DSH session store — create/read/write/list/rename sessions against any profile (default headless), sharing the session-tool service layer with the agent tools",
  "type": "module",
  "bin": {
    "dsh-session": "lib/bin.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/dsh-app-boot": "link:../../../plugin-dev/session-tool-env/packages/boot/app-boot",
    "@deepseek-ai/dsh-environment": "link:../../../plugin-dev/session-tool-env/packages/util/environment",
    "@deepseek-ai/dsh-paths": "link:../../../plugin-dev/session-tool-env/packages/util/paths",
    "@deepseek-ai/dsh-session": "link:../../../plugin-dev/session-tool-env/packages/core/session",
    "commander": "^15.0.0",
    "session-tool": "workspace:*"
  },
  "peerDependencies": {
    "@cordisjs/plugin-include": "^1.0.0-rc.5",
    "cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@cordisjs/plugin-include": "link:../../../plugin-dev/session-tool-env/vendor/include",
    "cordis": "link:../../../plugin-dev/session-tool-env/vendor/cordis"
  }
}
