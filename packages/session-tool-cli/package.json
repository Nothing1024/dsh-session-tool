{
  "name": "session-tool-cli",
  "version": "0.1.0",
  "private": true,
  "description": "The dsh-session CLI: an auxiliary operator for the DSH session store — create/read/write/list/rename sessions against any profile (default headless), sharing the session-tool service layer with the agent tools",
  "type": "module",
  "bin": {
    "dsh-session": "lib/bin.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsdown",
    "test": "vitest run --config ../../vitest.config.ts packages/session-tool-cli/tests"
  },
  "dependencies": {
    "@cordisjs/plugin-include": "^1.0.0-rc.5",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-app-boot": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "commander": "^15.0.0",
    "session-marks": "workspace:*",
    "session-tool": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.2-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.1.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.1.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1"
  }
}
