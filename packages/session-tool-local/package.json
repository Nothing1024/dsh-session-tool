{
  "name": "session-tool-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local provider for the session-tool Service Definition: implements ctx.sessionTool over the DSH session stack (live store, JSONL/SQLite persistence, title and tag services)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsdown"
  },
  "dependencies": {
    "session-tool": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.0.1",
    "@deepseek-ai/dsh-session": "^0.0.1",
    "@deepseek-ai/dsh-session-persistence": "^0.0.1",
    "@deepseek-ai/dsh-session-tags": "^0.0.1",
    "@deepseek-ai/dsh-session-title": "^0.0.1",
    "cordis": "^4.0.0-rc.7",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "link:../../../plugin-dev/session-tool-env/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../../../plugin-dev/session-tool-env/packages/core/session",
    "@deepseek-ai/dsh-session-persistence": "link:../../../plugin-dev/session-tool-env/packages/session/session-persistence",
    "@deepseek-ai/dsh-session-persistence-jsonl": "link:../../../plugin-dev/session-tool-env/packages/session/session-persistence-jsonl",
    "@deepseek-ai/dsh-session-tags": "link:../../../plugin-dev/session-tool-env/packages/session/session-tags",
    "@deepseek-ai/dsh-session-title": "link:../../../plugin-dev/session-tool-env/packages/session/session-title",
    "cordis": "link:../../../plugin-dev/session-tool-env/vendor/cordis",
    "schemastery": "link:../../../plugin-dev/session-tool-env/vendor/schemastery"
  }
}
