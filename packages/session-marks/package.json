{
  "name": "session-marks",
  "version": "0.1.0",
  "private": true,
  "description": "Plugin-owned session mark table (jsonl under DSH_HOME). Pure library: put/get/listByKind, no cordis, no official session/tags events.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsdown",
    "test": "vitest run --config ../../vitest.config.ts packages/session-marks/tests"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  }
}
