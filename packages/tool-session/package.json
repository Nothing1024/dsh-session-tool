{
  "name": "tool-session",
  "version": "0.1.0",
  "private": true,
  "description": "DSH session management bundle: the five session_* agent tools (create/read/write/list/rename) plus the bundle patch mounting session-tags, session-tool-local, and the tools over dsh-base",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-session-tags": "link:../../../env/session-tool-env/packages/session/session-tags",
    "session-tool-local": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.0.1",
    "@deepseek-ai/dsh-session": "^0.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1",
    "cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "link:../../../env/session-tool-env/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../../../env/session-tool-env/packages/core/session",
    "@deepseek-ai/dsh-tools": "link:../../../env/session-tool-env/packages/core/tools",
    "cordis": "link:../../../env/session-tool-env/vendor/cordis"
  }
}
