{
  "name": "session-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Session management Service Definition for DSH: the ctx.sessionTool contract (create/read/write/list/rename) shared by the model-facing tools, the dsh-session CLI, and every provider",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6"
  }
}
