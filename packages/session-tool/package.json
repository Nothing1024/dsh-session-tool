{
  "name": "session-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Session management Service Definition for DSH: the ctx.sessionTool contract (create/read/write/list/rename) shared by the model-facing tools, the dsh-session CLI, and every provider",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "link:../../../env/session-tool-env/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../../../env/session-tool-env/packages/core/session"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7"
  }
}
